{
  "name": "legal-mind",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:api": "turbo dev --filter=@legal-mind/api",
    "dev:web": "turbo dev --filter=@legal-mind/web",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:migrate": "pnpm --filter=@legal-mind/db migrate",
    "rag:ingest": "node scripts/rag-ingest.mjs",
    "rag:test": "bun --env-file .env scripts/test-rag-retrieval.ts"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.11"
  }
}
